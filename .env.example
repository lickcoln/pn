# Paranoid Noise Environment Variables
# Fill in your Supabase credentials if you want to connect to Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the public address of the website, used in link previews (WhatsApp, Instagram, X) and the canonical tag.
# Not needed on Vercel: builds there use https://paranoidnoise.com (SITE_ORIGIN in vite.config.js).
# Set it only to override that, for example for another domain.
# VITE_SITE_URL=
