# Paranoid Noise Environment Variables
# Fill in your Supabase credentials if you want to connect to Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the public address of the website, used in link previews (WhatsApp, Instagram, X).
# Not needed on Vercel (the production domain is picked up automatically);
# set it when the site has its own domain, for example https://www.paranoidnoise.com
# VITE_SITE_URL=
